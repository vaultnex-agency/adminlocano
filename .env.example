# Copy this file to .env.local and fill in your Supabase project values.
# NEVER commit .env.local — it is blocked by .gitignore.

# Supabase project URL (safe to expose — it is public)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase anon/public key (safe to expose — RLS enforces access)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here

# ────────────────────────────────────────────────────────────────────
# NEVER add the following to this file or any file tracked by git:
#   SUPABASE_SERVICE_ROLE_KEY  — grants full DB bypass; server-only
#   Any admin email or password
# ────────────────────────────────────────────────────────────────────

